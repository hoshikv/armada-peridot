    "panel_timing": {
      "hactive": 1220,
      "vactive": 2712,
      "hfp": 80,
      "hsa": 8,
      "hbp": 80,
      "vfp": 24,
      "vsa": 4,
      "vbp": 16,
      "pixclk_mhz": 432
