      "framebuffer": {"base": "0xE3940000", "size": "43MB"},
      "scmi_shmem": {"base": "0x81D20000", "size": "64KB"}
    }
  },
  "boot": {
    "payload_base": "0xF0000000",
    "fd_base": "0xA7100000",
    "fd_size": "0x300000",
    "fb_base": "0xE3940000",
    "media_base": "0x90000000",
