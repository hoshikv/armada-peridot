      "0x0C223000",
      "0x0C224000"
    ],
    "cpu_clusters": 3,
    "cluster_topology": {
      "cluster0": {"name": "small", "cpus": [0,1,2], "arch": "Cortex-A520", "scmi_domain": 0},
      "cluster1": {"name": "big", "cpus": [3,4,5,6], "arch": "Cortex-A720", "scmi_domain": 1},
      "cluster2": {"name": "prime", "cpus": [7], "arch": "Cortex-X4", "scmi_domain": 2}
    },
    "thermal_limits_celsius": {
      "core_passive": 95,
      "other_sensors": 100,
      "emergency": 115,
      "battery_half": 50,
      "battery_lowest": 58
