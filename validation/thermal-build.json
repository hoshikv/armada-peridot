      "cx_misc": "0x03D9E000",
      "rscc": "0x03D50000",
      "smmu": "0x03DA0000"
    },
    "firmware": [
      "a660_zap.mdt",
      "a660_gmu.bin",
      "a660_sqe.fw"
    ]
  },
  "display": {
    "resolution": "1220x2712",
